{
  "name": "timetable-test-suite",
  "version": "1.0.0",
  "description": "Automated test suite for Timetable Management System",
  "scripts": {
    "setup": "node setup-test-users.js",
    "test": "jest --runInBand",
    "test:auth": "jest tests/auth.test.ts",
    "test:api": "jest tests/api-security.test.ts",
    "test:performance": "jest tests/performance.test.ts",
    "test:all": "jest --runInBand --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "load-test": "artillery run tests/load/load-test.yml",
    "security-scan": "node tests/security/security-scan.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@playwright/test": "^1.40.0",
    "artillery": "^2.0.0",
    "axios": "^1.6.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}
